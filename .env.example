# Copy to .env and fill in.

# Shown as "The <name> Archive"
FAMILY_NAME=Smith

# Not needed: the site works out its own address, both at home (http) and through a tunnel (https).
# Only set it if a proxy in front of the site doesn't send X-Forwarded-Proto.
# ORIGIN=https://family.example.com

# Uploads arrive in 32 MB pieces; the default limit (512K) would refuse them.
BODY_SIZE_LIMIT=64M

# Where the database and media live (the Docker image sets this to /data)
# DATA_DIR=./data
